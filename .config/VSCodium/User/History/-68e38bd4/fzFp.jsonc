{
    "layer": "top",
    "width": 1500,
    "modules-left": [
        "pulseaudio",
        "cava",
        "temperature",
        "cpu",
        "memory"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "clock#right"
    ],
    "modules-right": [
        "custom/updates",
        "battery",
        "custom/power",
        "custom/notification"
    ],
    "clock": {
        "format": "{:%H}"
    },
    "clock#right": {
        "format": "{:%M}"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "wlogout"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        },
        "persistent-workspaces": {
            "*": 5 // 5 workspaces by default on every monitor
        }
    },
    "battery": {
        "interval": 60,
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰢟",
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ]
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": " {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "󰕿",
                "󰕾"
            ]
        },
        "on-click": "~/.config/waybar/scripts/audio-popup.sh",
        "scroll-step": 5
    },
    "custom/notification": {
        "tooltip": false,
        "format": "󰂟",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d"
    },
    "cava": {
        //"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
        "framerate": 30,
        "autosens": 1,
        //"sensitivity": 100,
        "bars": 14,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "bar_delimiter": 0,
        "reverse": false,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "actions": {
            "on-click-right": "mode"
        }
    },
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true,
        "on-click": "kitty -e btop"
    },
    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "tooltip": true
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {}%",
        "tooltip": true,
        "on-click": "kitty -e btop"
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/arch-updates.sh",
        "return-type": "json",
        "interval": 300,
        "format": "{}",
        "tooltip": true,
        "on-click": "kitty -e sh -c 'sudo pacman -Syu; echo; read -n 1 -s -r -p \"Press any key to close...\"'"
    }
}